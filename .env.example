# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Why a committed *example* plus an ignored real file: the example documents
# which variables exist (so a new machine or teammate knows what to set) while
# the real values — passwords today, the JWT secret later — never enter git
# history. A secret committed once is committed forever, even if deleted later.
#
# The app reads these via app/core/config.py (pydantic-settings). Names here
# match the field names there, case-insensitively.

# --- PostgreSQL connection ---
# The convenient form for local development: individual parts.
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finance_tracker

# Full SQLAlchemy connection URL.
# If set, this takes precedence over the individual POSTGRES_* vars above
# (see Settings.sqlalchemy_url). Hosting platforms and Docker Compose hand you
# a single URL like this, so supporting both forms means deploying doesn't
# require reshaping the config.
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
#         └─dialect─┘ └─driver─┘
DATABASE_URL=postgresql+psycopg2://finance:change-me@localhost:5432/finance_tracker

# --- Auth / JWT ---
# The key that signs and verifies access tokens. The value below is a public
# placeholder — it is in this repository, so a deployment still using it would
# accept tokens forged by anyone who read the source. config.py refuses to start
# with it when DEBUG=false for exactly that reason.
#
# Generate a real one:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-insecure-secret-change-me

# HS256 = one shared secret both signs and verifies. See config.py for when
# you'd want RS256 instead (a different service verifying tokens it can't mint).
JWT_ALGORITHM=HS256

# How long an access token stays valid. Kept short because a JWT is checked
# offline — there is no server-side list to remove it from, so expiry is the
# only thing limiting a stolen token.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- App ---
APP_NAME=Personal Finance Tracker
# development | staging | production. Anything other than "development" makes
# the app refuse to boot with the placeholder SECRET_KEY above.
ENVIRONMENT=development
# true also turns on SQLAlchemy's SQL echo — useful for seeing exactly which
# queries the ORM emits while learning. Keep it false in production: it's noisy
# and logs query parameters.
DEBUG=true

# --- CORS (frontend origins allowed to call this API) ---
# Comma-separated, scheme included, no trailing slash. Needed because the Vite
# dev server (:5173) and this API (:8000) are different origins to a browser.
# In production this is the deployed frontend's URL. Never "*" — the wildcard
# cannot be combined with credentialed requests and would let any page on the
# internet call this API with a user's session.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
