# Copy to `.env` (or `.env.local`) — both are gitignored.
#
# Where the FastAPI backend lives. No trailing slash.
#
# Only VITE_-prefixed variables reach the browser, and everything that does is
# baked into the built bundle in plain text. That makes this the right place for
# a public API URL and the wrong place for any secret.
VITE_API_URL=http://127.0.0.1:8000
